{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{1,38}[a-z0-9])$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "shortName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 24
    },
    "tagline": {
      "default": "",
      "type": "string",
      "maxLength": 140
    },
    "description": {
      "default": "",
      "type": "string",
      "maxLength": 2000
    },
    "locale": {
      "default": "ru-RU",
      "type": "string"
    },
    "timezone": {
      "type": "string"
    },
    "currency": {
      "default": "RUB",
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "contacts": {
      "type": "object",
      "properties": {
        "address": {
          "type": "string",
          "minLength": 5,
          "maxLength": 200
        },
        "phone": {
          "type": "string",
          "minLength": 6,
          "maxLength": 32
        },
        "mapUrl": {
          "type": "string",
          "pattern": "^https:\\/\\/"
        },
        "messengerUrl": {
          "type": "string",
          "pattern": "^https:\\/\\/"
        }
      },
      "required": [
        "address",
        "phone"
      ]
    },
    "theme": {
      "type": "object",
      "properties": {
        "accent": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      },
      "required": [
        "accent"
      ]
    },
    "booking": {
      "type": "object",
      "properties": {
        "slotStepMinutes": {
          "default": 30,
          "anyOf": [
            {
              "type": "number",
              "const": 10
            },
            {
              "type": "number",
              "const": 15
            },
            {
              "type": "number",
              "const": 20
            },
            {
              "type": "number",
              "const": 30
            },
            {
              "type": "number",
              "const": 60
            }
          ]
        },
        "minLeadMinutes": {
          "default": 60,
          "type": "integer",
          "minimum": 0,
          "maximum": 10080
        },
        "maxDaysAhead": {
          "default": 30,
          "type": "integer",
          "minimum": 1,
          "maximum": 180
        },
        "cancelCutoffHours": {
          "default": 3,
          "type": "integer",
          "minimum": 0,
          "maximum": 168
        },
        "cancellationPolicy": {
          "default": "",
          "type": "string",
          "maxLength": 600
        }
      }
    },
    "hours": {
      "type": "object",
      "properties": {
        "mon": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):([0-5]\\d)-([01]\\d|2[0-4]):([0-5]\\d)$"
          }
        },
        "tue": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):([0-5]\\d)-([01]\\d|2[0-4]):([0-5]\\d)$"
          }
        },
        "wed": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):([0-5]\\d)-([01]\\d|2[0-4]):([0-5]\\d)$"
          }
        },
        "thu": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):([0-5]\\d)-([01]\\d|2[0-4]):([0-5]\\d)$"
          }
        },
        "fri": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):([0-5]\\d)-([01]\\d|2[0-4]):([0-5]\\d)$"
          }
        },
        "sat": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):([0-5]\\d)-([01]\\d|2[0-4]):([0-5]\\d)$"
          }
        },
        "sun": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):([0-5]\\d)-([01]\\d|2[0-4]):([0-5]\\d)$"
          }
        }
      }
    },
    "closedDates": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "note": {
            "default": "",
            "type": "string",
            "maxLength": 120
          }
        },
        "required": [
          "date"
        ]
      }
    },
    "specialHours": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "hours": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):([0-5]\\d)-([01]\\d|2[0-4]):([0-5]\\d)$"
            }
          },
          "note": {
            "default": "",
            "type": "string",
            "maxLength": 120
          }
        },
        "required": [
          "date",
          "hours"
        ]
      }
    },
    "resources": {
      "minItems": 1,
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,40}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          }
        },
        "required": [
          "key",
          "name"
        ]
      }
    },
    "services": {
      "minItems": 1,
      "maxItems": 60,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,40}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "description": {
            "default": "",
            "type": "string",
            "maxLength": 600
          },
          "category": {
            "default": "",
            "type": "string",
            "maxLength": 40
          },
          "duration": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "string",
                "pattern": "^(?:(\\d+)d)?\\s*(?:(\\d+)h)?\\s*(?:(\\d+)m)?$"
              }
            ]
          },
          "buffer": {
            "default": 0,
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "string",
                "pattern": "^(?:(\\d+)d)?\\s*(?:(\\d+)h)?\\s*(?:(\\d+)m)?$"
              }
            ]
          },
          "price": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000000
          },
          "priceFrom": {
            "default": false,
            "type": "boolean"
          },
          "resources": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,40}$"
            }
          },
          "image": {
            "type": "string",
            "pattern": "^images\\/[A-Za-z0-9._/-]+\\.(?:jpe?g|png|webp)$"
          }
        },
        "required": [
          "key",
          "name",
          "duration",
          "price",
          "resources"
        ]
      }
    },
    "infoCards": {
      "minItems": 3,
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "icon": {
            "type": "string",
            "pattern": "^[A-Za-z]{2,40}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "text": {
            "default": "",
            "type": "string",
            "maxLength": 160
          }
        },
        "required": [
          "icon",
          "title"
        ]
      }
    },
    "gallery": {
      "default": [],
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,40}$"
          },
          "image": {
            "type": "string",
            "pattern": "^images\\/[A-Za-z0-9._/-]+\\.(?:jpe?g|png|webp)$"
          },
          "caption": {
            "default": "",
            "type": "string",
            "maxLength": 120
          }
        },
        "required": [
          "key",
          "image"
        ]
      }
    },
    "media": {
      "type": "object",
      "properties": {
        "hero": {
          "type": "string",
          "pattern": "^images\\/[A-Za-z0-9._/-]+\\.(?:jpe?g|png|webp)$"
        },
        "logo": {
          "type": "string",
          "pattern": "^images\\/[A-Za-z0-9._/-]+\\.(?:jpe?g|png|webp)$"
        },
        "icon": {
          "type": "string",
          "pattern": "^images\\/[A-Za-z0-9._/-]+\\.(?:jpe?g|png|webp)$"
        },
        "iconFullBleed": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "hero",
        "logo",
        "icon"
      ]
    }
  },
  "required": [
    "slug",
    "name",
    "shortName",
    "timezone",
    "contacts",
    "theme",
    "booking",
    "hours",
    "resources",
    "services",
    "infoCards",
    "media"
  ]
}
