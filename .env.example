# ─── Frontend (public, baked into the static build) ─────────────────────────────
# Supabase project URL and anon/publishable key (Settings → API). Safe to expose.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=
# Assistant (client + owner) is off for now; set to true to show it again.
VITE_ASSISTANT_ENABLED=false
# VAPID public key for Web Push (pnpm vapid:generate prints both keys).
VITE_VAPID_PUBLIC_KEY=
# Public site URL (used in Open Graph tags and printed links).
PUBLIC_SITE_URL=https://your-site.vercel.app

# ─── Pipeline scripts (your machine / CI only — never in the frontend) ──────────
# Postgres connection string (Settings → Database → Connection string, session mode).
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=
# Service role key: server-side only. Used by tenant:publish to upload images and create owners.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Edge Function secrets (set with `supabase secrets set`, NOT in the frontend) ─
# Any OpenAI-compatible endpoint. Leave LLM_API_KEY empty to run the assistant in data-only mode.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# auto | tools | json  (auto: function calling, falls back to JSON intent if the provider lacks tools)
LLM_TOOL_MODE=auto
LLM_TIMEOUT_MS=20000
LLM_DAILY_TOKENS_PER_TENANT=200000
LLM_DAILY_TOKENS_GLOBAL=2000000
AI_RATE_PER_IP_10MIN=20
AI_RATE_PER_TENANT_HOUR=300
# Web Push (VAPID). Subject is a mailto: or https: contact.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com
# Shared secret between Supabase Cron and the notify-worker function (any long random string).
NOTIFY_WORKER_SECRET=

# ─── Local gateway (only when running without Docker, see SETUP.md) ─────────────
GATEWAY_PORT=54321
GATEWAY_JWT_SECRET=local-gateway-secret-not-for-production-use-0001
